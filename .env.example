# Email Link Verification Configuration

# Copy this to your .env file or set as environment variables

# Method 1: Outlook Web App Credentials
OUTLOOK_EMAIL=your-email@outlook.com
OUTLOOK_PASSWORD=your-password

# Method 2: Microsoft Graph API (more reliable for automation)
# Get these from Azure App Registration
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret

# Method 3: Alternative Email Services
GMAIL_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password  # Use app-specific password

# Test Configuration
TEST_EMAIL_TIMEOUT=30000
EMAIL_CHECK_INTERVAL=5000