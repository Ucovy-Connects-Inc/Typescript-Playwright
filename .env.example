# Unified Playwright BDD Configuration

# Execution environment
TEST_ENV=qa
HEADLESS=true
ENABLE_JIRA=false

# Base URLs
BASE_URL=https://ecommerce-playground.lambdatest.io
LOCAL_BASE_URL=http://localhost:3000
DEV_BASE_URL=https://dev.example.com
QA_BASE_URL=https://ecommerce-playground.lambdatest.io
PROD_BASE_URL=https://prod.example.com

# Optional reusable credentials
DEFAULT_USER_EMAIL=registered.user@example.com
DEFAULT_USER_PASSWORD=SecurePass123!
INVALID_USER_EMAIL=invalid@email.com
INVALID_USER_PASSWORD=wrongpassword

# Email Link Verification Configuration
OUTLOOK_EMAIL=your-email@outlook.com
OUTLOOK_PASSWORD=your-password
MICROSOFT_TENANT_ID=your-tenant-id
MICROSOFT_CLIENT_ID=your-client-id
MICROSOFT_CLIENT_SECRET=your-client-secret
GMAIL_EMAIL=your-email@gmail.com
GMAIL_APP_PASSWORD=your-app-password

# Test Configuration
TEST_EMAIL_TIMEOUT=30000
EMAIL_CHECK_INTERVAL=5000
